{
  "buildCommand": null,
  "installCommand": null,
  "framework": null,
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "nvl-intern.vercel.app"
        }
      ],
      "destination": "https://intern.neovibelab.com/:path*",
      "permanent": true
    }
  ]
}
